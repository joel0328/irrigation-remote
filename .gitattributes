* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf

# Raw captures and binary artifacts go through Git LFS.
captures/**/*.sal  filter=lfs diff=lfs merge=lfs -text
captures/**/*.sr   filter=lfs diff=lfs merge=lfs -text
captures/**/*.dsl  filter=lfs diff=lfs merge=lfs -text
captures/**/*.vcd  filter=lfs diff=lfs merge=lfs -text
captures/**/*.bin  filter=lfs diff=lfs merge=lfs -text
captures/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
captures/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
captures/**/*.png  filter=lfs diff=lfs merge=lfs -text
hardware/**/*.zip  filter=lfs diff=lfs merge=lfs -text
hardware/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
# Large CSV exports: route them by name, e.g. *_raw.csv
captures/**/*_raw.csv filter=lfs diff=lfs merge=lfs -text
